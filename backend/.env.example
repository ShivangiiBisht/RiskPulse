# 1 = use only cached API responses (safe demo mode, no network calls)
OFFLINE_MODE=0
CACHE_TTL_SECONDS=900
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Sentiment: auto (FinBERT if installed, else lexicon) | finbert | lexicon
SENTIMENT_BACKEND=auto
# Event classification: rules | zeroshot (needs requirements-ml.txt, downloads ~1.6 GB model)
EVENT_BACKEND=rules

# Optional overrides (defaults: ../data/sample_tweets.csv, or backend/data/stock_tweets.csv if present)
# TWEETS_CSV_PATH=
